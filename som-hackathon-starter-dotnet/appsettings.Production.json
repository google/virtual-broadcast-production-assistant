{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "SomSkillWorker": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "${KAFKA_BOOTSTRAP_SERVERS}",
    "GroupId": "som-skill-worker",
    "SecurityProtocol": "SaslSsl",
    "SaslMechanism": "Plain",
    "SaslUsername": "${KAFKA_API_KEY}",
    "SaslPassword": "${KAFKA_API_SECRET}",
    "StoryContextTopic": "som.story.context",
    "SkillEventsTopic": "som.skills.events",
    "SkillRunsTopic": "som.skills.runs",
    "SkillStagingTopic": "som.skills.staging",
    "SkillRejectedTopic": "som.skills.rejected",
    "DashboardGroupId": "som-dashboard"
  }
}

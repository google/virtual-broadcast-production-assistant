# Copy to .env.local and fill in. Gitignored.
# GCP Managed Kafka via Tailscale + ADC. SaslPassword is injected at runtime from
# `gcloud auth print-access-token` — do NOT set it here.

Kafka__BootstrapServers=bootstrap.som-kafka-cluster.europe-west1.managedkafka.ibc-smart-stories.cloud.goog:9092
Kafka__SecurityProtocol=SaslSsl
Kafka__SaslUsername=storyobjectmodel@gmail.com
ASPNETCORE_ENVIRONMENT=Production
